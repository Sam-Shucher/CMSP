DB_HOST=localhost
DB_USER=mini_library_user
DB_PASS=your_password_here
DB_NAME=mini_library
# Required, 32+ characters — the server refuses to start without a strong one.
# Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string
# Development: 3001 (Vite dev server proxies /api here).
# Production (Raspberry Pi): 4233 — the backend serves the built frontend too,
# and the Cloudflare Tunnel points at this port. scripts/rpi-setup.sh sets this.
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# The group's city, for "today", booking days and handoff hours (6am-10pm).
# Optional: America/Chicago when left out.
# APP_TIMEZONE=America/Chicago
# Phone notifications (Web Push). Optional — the site runs without them.
# scripts/rpi-update.sh generates the pair on the Pi; locally, run
# `npm --prefix backend run vapid:keys` and paste the two lines here.
# Keep the pair once phones have signed up: a new one silently stops each
# phone's notifications until it next opens the app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Push services need a contact: FRONTEND_URL is used when it's https://.
# Otherwise (e.g. testing locally) set a mailto: address here.
# VAPID_SUBJECT=mailto:you@example.com
