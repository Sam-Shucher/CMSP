{
  // Covers the repo-level tooling: the end-to-end tests and the Playwright
  // config. The app itself is built by backend/tsconfig.json and
  // frontend/tsconfig.json.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "tests/**/*.ts", "tests/**/*.cjs",
    "playwright.config.ts", "eslint.config.mjs",
    "backend/vitest.config.ts", "backend/vitest.integration.config.ts"
  ]
}
